# Telegram Bot Token (@BotFather orqali olinadi)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz

# Administrator Telegram ID lari (vergul bilan ajratilgan)
ADMIN_IDS=123456789,987654321

# Ma'lumotlar bazasi URL manzili (PostgreSQL yoki SQLite)
# PostgreSQL uchun: postgresql+asyncpg://user:password@localhost:5432/ibnsino_db
# SQLite uchun: sqlite+aiosqlite:///ibnsino.db
DATABASE_URL=sqlite+aiosqlite:///ibnsino.db
