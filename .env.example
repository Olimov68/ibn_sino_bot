# Telegram Bot Token (@BotFather orqali olinadi)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz

# Administrator Telegram ID lari (vergul bilan ajratilgan)
ADMIN_IDS=123456789,987654321

# PostgreSQL ma'lumotlar bazasi URL manzili (asyncpg drayveri bilan)
# Docker ichida: postgresql+asyncpg://ibnsino:ibnsino_password@postgres:5432/ibnsino_db
DATABASE_URL=postgresql+asyncpg://ibnsino:ibnsino_password@localhost:5432/ibnsino_db

# PostgreSQL Docker sozlamalari
POSTGRES_USER=ibnsino
POSTGRES_PASSWORD=ibnsino_password
POSTGRES_DB=ibnsino_db
POSTGRES_PORT=5432
